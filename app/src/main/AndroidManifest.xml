<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".SukainaApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SukainaTube">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SukainaTube.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.watch.WatchActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:theme="@style/Theme.SukainaTube" />

        <activity
            android:name=".ui.lists.VideoListActivity"
            android:theme="@style/Theme.SukainaTube"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.parent.ParentPinActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.SukainaTube" />

        <activity
            android:name=".ui.parent.ParentSettingsActivity"
            android:theme="@style/Theme.SukainaTube" />

        <activity
            android:name=".ui.parent.SearchActivity"
            android:theme="@style/Theme.SukainaTube"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <activity
            android:name=".ui.parent.OnboardingActivity"
            android:theme="@style/Theme.SukainaTube.Splash"
            android:exported="false" />
    </application>

</manifest>
