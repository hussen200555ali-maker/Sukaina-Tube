<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/parent_pin_title"
            android:src="@drawable/ic_lock"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/parent_pin_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/parent_pin_enter"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pin_field"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:letterSpacing="0.5"
            android:maxLength="4"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/pinConfirm"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pin_field"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:letterSpacing="0.5"
            android:maxLength="4"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/yt_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="220dp"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_red"
            android:text="@string/parent_pin_enter"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:text="@string/action_back"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
